{
  "name": "shiguang-reader",
  "version": "1.142.0",
  "type": "module",
  "description": "拾光阅读：DeepSeek Harness 本地书架与沉浸式阅读插件。",
  "license": "Apache-2.0",
  "author": "sayhia",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "hostlib.js",
    "hostindex.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots/*.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test.mjs && node test-host.mjs",
    "build": "node build.mjs",
    "dev": "node dev.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayhia/shiguang-reader.git"
  },
  "homepage": "https://github.com/sayhia/shiguang-reader#readme",
  "bugs": {
    "url": "https://github.com/sayhia/shiguang-reader/issues"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "reader",
    "epub",
    "bookshelf"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
